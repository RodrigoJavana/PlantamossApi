# Copia este archivo como .env (NO subas el .env a git).
# docker compose lo lee automáticamente para el servicio "api".

# Clave para firmar los JWT (OBLIGATORIA, mínimo 32 caracteres aleatorios).
# Ya NO existe valor por defecto en appsettings: sin ella la API no arranca.
# Genérala con el script configurar-env.ps1 (usa RandomNumberGenerator, criptográficamente seguro).
JWT_KEY=

# Pepper secreto del HMAC-SHA256 con el que se guardan los códigos de 6 dígitos (recomendado; 32+ caracteres).
# Si se deja vacío se deriva de JWT_KEY.
PEPPER_CODIGOS=

# Cadena de conexión para `dotnet run` (vacía = la de desarrollo local de appsettings.Development.json).
# En producción defínela aquí o como variable de entorno ConnectionStrings__Default.
DB_CONNECTION=

# Origen del front Vue
CORS_ORIGIN=http://localhost:5173

# Servicios externos (proxy del servidor)
OPENWEATHER_API_KEY=
YOUTUBE_API_KEY=

# SMTP (vacío = los códigos se imprimen en el log de la API)
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_ENABLE_SSL=true
# SMTP_PASSWORD debe ser una "contraseña de aplicación" de Google, no tu contraseña normal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# pgAdmin (solo con: docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@plantamoss.com
PGADMIN_PASSWORD=plantamoss_dev
